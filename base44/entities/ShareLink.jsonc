{
  "name": "ShareLink",
  "properties": {
    "active": {
      "default": true,
      "type": "boolean"
    },
    "expires_at": {
      "format": "date",
      "type": "string"
    },
    "guest_email": {
      "type": "string"
    },
    "guest_name": {
      "type": "string"
    },
    "invited_by": {
      "description": "Name of the project manager who created this link, if not the owner",
      "type": "string"
    },
    "last_opened": {
      "type": "string"
    },
    "owner_id": {
      "description": "Account owner's user id. Set when a project manager creates the link, so it still belongs to the owner's account",
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "portfolio_id": {
      "type": "string"
    },
    "portfolio_name": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "role": {
      "default": "customer",
      "description": "project_manager = runs one portfolio and its projects, limited to the portfolio on the link",
      "enum": [
        "customer",
        "team_member",
        "project_manager"
      ],
      "type": "string"
    },
    "scope": {
      "default": "project",
      "enum": [
        "project",
        "portfolio"
      ],
      "type": "string"
    },
    "token": {
      "description": "Long random secret in the guest link",
      "type": "string"
    }
  },
  "required": [
    "token",
    "role",
    "scope"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    }
  },
  "type": "object"
}