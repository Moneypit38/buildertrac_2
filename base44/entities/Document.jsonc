{
  "name": "Document",
  "properties": {
    "category": {
      "default": "Plans",
      "enum": [
        "Plans",
        "Invoices",
        "Change Order",
        "Permits",
        "Contract"
      ],
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "file_url": {
      "format": "uri",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner_id": {
      "description": "Account owner's user id; set when a guest uploads via a share link",
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "size": {
      "type": "string"
    },
    "uploaded_by_guest": {
      "type": "string"
    },
    "version": {
      "default": 1,
      "type": "number"
    }
  },
  "required": [
    "name",
    "project_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    }
  },
  "type": "object"
}