{
  "name": "PortfolioMember",
  "type": "object",
  "properties": {
    "portfolio_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "member",
        "viewer"
      ],
      "default": "member"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "portfolio_id",
    "user_email",
    "role"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}