{
  "name": "Project",
  "properties": {
    "address": {
      "type": "string"
    },
    "budget_spent": {
      "default": 0,
      "type": "number"
    },
    "budget_total": {
      "default": 0,
      "type": "number"
    },
    "description": {
      "maxLength": 1000,
      "type": "string"
    },
    "follow_up_off": {
      "default": false,
      "description": "Turn follow-up reminders off for this project",
      "type": "boolean"
    },
    "follow_up_snoozed_until": {
      "description": "Hide the follow-up reminder until this date (YYYY-MM-DD)",
      "type": "string"
    },
    "image": {
      "format": "uri",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner_id": {
      "description": "Account owner's user id; set when a portfolio admin adds a project via a share link",
      "type": "string"
    },
    "portfolio": {
      "type": "string"
    },
    "status": {
      "default": "Planning",
      "enum": [
        "Planning",
        "In Progress",
        "On Hold",
        "Completed"
      ],
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "type": "object",
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    }
  }
}