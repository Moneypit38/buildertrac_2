{
  "name": "Task",
  "properties": {
    "assigned_to": {
      "type": "string"
    },
    "completed": {
      "default": false,
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "format": "date",
      "type": "string"
    },
    "owner_id": {
      "description": "Account owner's user id; set when a guest admin adds a task via a share link",
      "type": "string"
    },
    "parent_task_id": {
      "type": "string"
    },
    "priority": {
      "default": "medium",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "reminder_sent": {
      "default": false,
      "type": "boolean"
    },
    "section": {
      "default": "today",
      "enum": [
        "today",
        "upcoming",
        "later"
      ],
      "type": "string"
    },
    "status": {
      "default": "Not Started",
      "enum": [
        "Not Started",
        "In Progress",
        "Pending Approval",
        "Blocked",
        "Done"
      ],
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "project_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    }
  },
  "type": "object"
}